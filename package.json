{
  "name": "market-intelligence-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Market Intelligence web app — Phase 1 (vanilla ES modules, no build step; runs directly in StackBlitz)",
  "scripts": {
    "build": "node build-check.mjs",
    "smoke": "node tests/smoke.mjs",
    "test:boot": "node tests/boot-harness.mjs",
    "dev": "node server.mjs",
    "serve": "node server.mjs",
    "build:http": "esbuild www/vendor/http-plugin.src.mjs --bundle --format=esm --platform=browser --target=es2020 --minify --outfile=www/vendor/http-plugin.js --sourcemap",
    "postinstall": "node scripts/patch-http-plugin-gradle.mjs"
  },
  "main": "Marketanalysis.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/branagh88/node-3tradingapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/branagh88/node-3tradingapp/issues"
  },
  "homepage": "https://github.com/branagh88/node-3tradingapp#readme",
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1"
  }
}
