# PetRockStudios SSSF environment — copy to .env at the target repo root.
#
# PRS DOES NOT NEED ANY KEYS HERE. Auth lives in ~/.pi/agent/auth.json and pi
# reads it directly (providers: opencode-go, opencode-free, deepseek). The
# roster runs on the flash family: opencode-free/deepseek-v4-flash-free (free)
# and opencode-go/deepseek-v4-flash (paid Go tier).
#
# Leave empty unless you add a roster agent on a provider pi does not resolve
# from auth.json (e.g. OPENROUTER_API_KEY if you add an openrouter model).

OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# PI_PATH=pi
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name
